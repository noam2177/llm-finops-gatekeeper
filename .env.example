# Copy to .env. Never commit real keys. --dry-run needs none of these.

# Tier 1: local model served by Ollama
GATEKEEPER_LOCAL_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Tier 2: any OpenAI-compatible chat completions API (OpenAI, Azure proxy, Z.AI, Together, ...)
GATEKEEPER_CLOUD_MODEL=gpt-4o-mini
GATEKEEPER_CLOUD_BASE_URL=https://api.openai.com/v1
GATEKEEPER_CLOUD_API_KEY=

GATEKEEPER_REQUEST_TIMEOUT_S=60

# FinOps pricing assumptions (USD per document / per call)
GATEKEEPER_PRICE_NAIVE_CLOUD_PER_DOC=0.015
GATEKEEPER_PRICE_LOCAL_PER_CALL=0.0002
GATEKEEPER_PRICE_CLOUD_PER_CALL=0.015
